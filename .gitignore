# Ignore Python virtual environments
env/
venv/
myenv/

# Ignore compiled Python files
*.pyc
__pycache__/

# Ignore logs
*.log

# Ignore system files
.DS_Store
Thumbs.db

# Ignore archive files
archive/

# Ignore recorded rollouts, but keep the directory itself
rollout_data/*
!rollout_data/.gitkeep
